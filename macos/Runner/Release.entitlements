<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stackyard reads SDK folders across your home folder and runs tools like
	     fvm, brew and sdkmanager, which the App Sandbox forbids. It's distributed
	     outside the Mac App Store, like other developer tools. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Lets the Finder fallback for "Move to Trash" work under the hardened
	     runtime that notarization requires. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
